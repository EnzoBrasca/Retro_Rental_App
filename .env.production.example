# Plantilla de variables para PRODUCCION.
#
# Copiala a .env.production en la RAIZ del repo (esta gitignoreado) y completa
# con valores REALES y fuertes. NUNCA commitees .env.production.
#
#   cp infra/env.production.example .env.production
#
# Uso:
#   docker compose --env-file .env.production \
#     -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# --- App ---
APP_DOMAIN=retrorental.com.ar
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
LETSENCRYPT_EMAIL=your-email@example.com

# --- Base de datos (PostgreSQL) ---
DB_NAME=postgres
DB_USER=admin
DB_PASSWORD=generalo-con-openssl-rand-base64-24
# DB_HOST y DB_PORT los fija docker-compose.yml (postgres:5432). No los definas aca.

# --- JWT ---
# Secreto largo y aleatorio (>= 32 bytes). Generalo con: openssl rand -base64 48
JWT_SECRET=generalo-con-openssl-rand-base64-48
JWT_EXPIRATION=3600000

# --- MinIO ---
MINIO_ACCESS_KEY=elegi-un-usuario
MINIO_SECRET_KEY=generalo-con-openssl-rand-base64-24
MINIO_BUCKET=tickets
MINIO_PUBLIC_ENDPOINT=https://files.retrorental.com.ar

# --- Mistral (opcional; sin key, el analisis OCR queda inactivo) ---
MISTRAL_API_KEY=tu-api-key-de-console.mistral.ai
