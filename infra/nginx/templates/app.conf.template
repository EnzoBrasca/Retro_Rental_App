# Reverse proxy de produccion. Unico servicio con puertos publicos.
#
# Esto es una PLANTILLA, no un .conf. La imagen oficial de nginx corre envsubst
# sobre /etc/nginx/templates/*.template al arrancar y escribe el resultado en
# /etc/nginx/conf.d/. El dominio sale de APP_DOMAIN (definido en
# .env.production), asi que no hay nada hardcodeado que editar a mano.
#
# NGINX_ENVSUBST_FILTER="^APP_" limita la sustitucion a las variables que
# empiezan con APP_. Es imprescindible: sin ese filtro, envsubst tambien se
# comeria las variables propias de nginx ($host, $scheme, $remote_addr...) y
# dejaria la config rota.
#
# Rutea por subdominio:
#   api.${APP_DOMAIN}   -> backend:8080  (la API que consume el mobile)
#   files.${APP_DOMAIN} -> minio:9000    (descarga de fotos via URLs presignadas)

# ---------------------------------------------------------------------------
# HTTP: validacion de Let's Encrypt + redirect a HTTPS
#
# El orden importa. La validacion ACME http-01 llega por HTTP PLANO al path
# /.well-known/acme-challenge/, asi que ese location tiene que resolverse ANTES
# del redirect. Si mandaramos todo a HTTPS, la emision del certificado fallaria
# ... y sin certificado no hay HTTPS. Huevo y gallina.
# ---------------------------------------------------------------------------
server {
    listen 80;
    server_name api.${APP_DOMAIN} files.${APP_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# API del backend
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name api.${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/api.${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.${APP_DOMAIN}/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    # Crear un ticket sube hasta 2 fotos (max-request-size 20MB en
    # application.yml). Dejamos margen para no cortar uploads legitimos.
    client_max_body_size 25m;

    location / {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Subir una foto desde el campo con señal mala puede tardar. El default
        # de 60s corta uploads que iban bien.
        proxy_read_timeout    300s;
        proxy_send_timeout    300s;
    }
}

# ---------------------------------------------------------------------------
# Almacenamiento MinIO (URLs presignadas)
#
# Las presigned URLs se firman con MINIO_PUBLIC_ENDPOINT=https://files.${APP_DOMAIN}.
# nginx reenvia el Host original a MinIO para que la firma valide: si lo
# reescribiera, la firma no coincidiria y toda descarga daria 403.
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name files.${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/files.${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/files.${APP_DOMAIN}/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;

    client_max_body_size 25m;

    location / {
        proxy_pass http://minio:9000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # MinIO maneja el streaming del objeto; que nginx lo bufferee entero
        # antes de responder solo agrega latencia y uso de disco.
        proxy_buffering       off;
        proxy_request_buffering off;
        proxy_read_timeout    300s;
        proxy_send_timeout    300s;
    }
}
