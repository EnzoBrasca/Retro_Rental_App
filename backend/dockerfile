# ---------- Etapa 1: Build ----------
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /app

# 1. Copiamos solo el pom y bajamos dependencias (capa cacheable)
COPY pom.xml .
RUN mvn dependency:go-offline -B

# 2. Ahora sí el código fuente y compilamos
COPY src ./src
RUN mvn clean package -DskipTests -B

# ---------- Etapa 2: Runtime ----------
FROM eclipse-temurin:21-jre AS runtime
WORKDIR /app

# Usuario no-root por seguridad
RUN groupadd -r spring && useradd -r -g spring spring

# Copiamos SOLO el jar generado en la etapa anterior
COPY --from=build /app/target/*.jar app.jar

USER spring
EXPOSE 8080

# Sin HEALTHCHECK, el orquestador solo sabe si el PROCESO esta vivo, no si la
# aplicacion esta sirviendo. Combinado con el nginx de infra/ como reverse
# proxy, un backend colgado pero con el proceso arriba seguiria recibiendo
# trafico (ver docs/BACKEND-AUDIT.md, INF-01).
#
# start-period da margen al arranque de Spring + Flyway: sin el, el contenedor
# se marcaria unhealthy durante los primeros segundos de cada despliegue.
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
    CMD wget -qO- http://localhost:8080/health || exit 1

ENTRYPOINT ["java", "-jar", "app.jar"]